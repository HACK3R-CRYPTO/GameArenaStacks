{
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "rootDir": "./src",
    "outDir": "./dist",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "src/SimpleAgent.ts",
    "src/deploy-contract.ts",
    "src/services/MoltbookService.ts",
    "src/debug_match.ts",
    "src/manual_resolve.ts",
    "dist"
  ]
}